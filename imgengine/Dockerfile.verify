FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        clang \
        libclang-rt-18-dev \
        cmake \
        git \
        imagemagick \
        libnuma-dev \
        libturbojpeg0-dev \
        liburing-dev \
        llvm \
        nasm \
        ninja-build \
        python3 \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && apt-get install -y --no-install-recommends cargo rustc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
