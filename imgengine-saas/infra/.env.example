# Local development only. Copy to `.env` or set values in your shell.
API_KEYS=local-test-key
WEB_API_KEY=local-test-key
INTERNAL_API_TOKEN=local-internal-token
DATABASE_URL=postgresql://imgengine:imgengine@db:5432/imgengine
POSTGRES_USER=imgengine
POSTGRES_PASSWORD=imgengine
POSTGRES_DB=imgengine
CORS_ORIGINS=http://localhost:3000

# Set to production only with non-default secrets and a URL-encoded database password.
# DEPLOYMENT_ENV=production
# LOG_LEVEL=INFO
