{
  "name": "imgengine-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:local-tools": "playwright test --config playwright.local-tools.config.ts",
    "test:browser:live": "playwright test --config playwright.live.config.ts",
    "typecheck": "nuxi typecheck",
    "build:free-static": "IMGENGINE_FREE_STATIC_BUILD=1 nuxt generate && node scripts/prepare-free-static.mjs",
    "verify:free-static": "node scripts/verify-free-static.mjs",
    "test:browser:free-static": "playwright test --config playwright.free-static.config.ts",
    "verify:free-publication-ready": "node scripts/check-free-publication-ready.mjs",
    "verify:free-release-dependencies": "node scripts/check-free-release-dependencies.mjs"
  },
  "dependencies": {
    "nuxt": "4.6.4",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@nuxt/schema": "4.6.4",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.15.3",
    "@vue/compiler-sfc": "3.5.44",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "overrides": {
      "@vue/server-renderer": "3.5.44",
      "node-forge": "1.4.3",
      "vue": "3.5.44"
    }
  }
}
