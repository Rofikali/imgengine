# Production compose metadata only. Do not put credentials in this file.
# Every image must be an immutable registry digest, never a mutable tag.
CADDY_IMAGE=registry.example/imgengine/caddy@sha256:replace-with-verified-digest
IMGENGINE_RUST_API_IMAGE=registry.example/imgengine/rust-api@sha256:replace-with-verified-digest
IMGENGINE_WEB_IMAGE=registry.example/imgengine/web@sha256:replace-with-verified-digest

# A DNS name already pointing at the host and an operational ACME contact.
CADDY_DOMAIN=photos.example.com
CADDY_EMAIL=ops@example.com

# Absolute paths to root-owned, mode-0600 files outside the repository.
IMGENGINE_API_KEYS_FILE=/etc/imgengine/secrets/api-keys
IMGENGINE_RENDER_API_KEY_FILE=/etc/imgengine/secrets/render-api-key

# These preserve the existing server-owned P8/P12 JPEG destination ceilings.
# They are not total process-memory limits or a production-capacity claim.
IMGENGINE_LAYOUT_MAX_OUTPUT_BYTES=16777216
IMGENGINE_SHEET_MAX_OUTPUT_BYTES=67108864
